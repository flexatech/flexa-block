{
	"name": "flexa-block",
	"version": "1.0.0",
	"description": "Gutenberg Container block with per-device flex layout, light/dark colors and save-time CSS generation.",
	"author": "Flexa",
	"license": "GPL-3.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"typecheck": "tsc --noEmit",
		"lint:reuse": "node scripts/audit-reuse.mjs",
		"test": "wp-scripts test-unit-js",
		"test:watch": "wp-scripts test-unit-js --watch",
		"check": "npm run lint:reuse && npm run typecheck && npm run test"
	},
	"devDependencies": {
		"@babel/runtime": "^8.0.0",
		"@wordpress/icons": "^15.0.0",
		"@wordpress/scripts": "^28.6.0",
		"typescript": "^6.0.0"
	},
	"dependencies": {
		"classnames": "^2.5.0",
		"fflate": "^0.8.3",
		"lottie-web": "^5.12.2",
		"swiper": "^11.2.10"
	}
}
